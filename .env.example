# Copiar a .env y completar. El .env no se versiona.

# --- Pipeline ---
# Ruta al YAML de configuracion. En Cloud Run los jobs usan config/gcp.yaml.
CHURN_CONFIG=config/model.yaml
CHURN_LOG_LEVEL=INFO

# --- API ---
CHURN_API_PREDICTIONS_DIR=outputs/predictions
CHURN_API_MODEL_DIR=models
# En produccion, restringir al dominio del dashboard en vez de "*".
CHURN_API_CORS_ORIGINS=*

# --- Dashboard ---
CHURN_API_URL=http://localhost:8000

# --- Puertos publicados por docker compose ---
# Descomentar si el 8000 o el 8080 ya los usa otro proyecto en tu maquina.
# API_PORT=8001
# WEB_PORT=8081

# --- Diagnosticos redactados por Claude (opcional, `make score-llm`) ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- GCP (targets `make gcp-*`) ---
# GCP_PROJECT=tu-proyecto
# GCP_REGION=us-central1
