# Imagen de la API de lectura.
# No incluye XGBoost ni SHAP: la API solo lee los parquet que dejo el batch, asi que
# la imagen queda chica y arranca rapido (importa para el escalado a cero de Cloud Run).

FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN pip install \
      "fastapi>=0.115,<0.120" \
      "uvicorn[standard]>=0.30,<0.40" \
      "pydantic>=2.8,<3.0" \
      "pydantic-settings>=2.4,<3.0" \
      "pandas>=2.2,<3.0" \
      "pyarrow>=16.0,<22.0"

COPY api/app ./app

ENV CHURN_API_PREDICTIONS_DIR=/app/outputs/predictions \
    CHURN_API_MODEL_DIR=/app/models \
    PORT=8000

EXPOSE 8000

# Cloud Run inyecta $PORT; en local queda en 8000.
CMD ["sh", "-c", "uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
